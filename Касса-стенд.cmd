@echo off
chcp 65001 >nul
rem ---------------------------------------------------------------------------
rem  Тестовая касса: стенд.
rem
rem  Фискальную часть считает эмулятор, а лента выходит из живой ККТ АТОЛ.
rem  Нужно потому, что без рабочего ФН настоящая касса фискальные команды
rem  не выполняет, а нефискальный документ печатает всегда.
rem
rem  Что можно проверить целиком:
rem    открытие смены -> продажа -> чек -> X-отчёт -> Z-отчёт,
rem  и всё это выходит на бумаге, с пометкой "НЕ ФИСКАЛЬНЫЙ ДОКУМЕНТ".
rem
rem  Сборка отладочная (tauri build --debug), поэтому стенд в ней есть.
rem  В релизной его нет физически: касса, молча пробившая чек в эмулятор,
rem  это худший из исходов.
rem ---------------------------------------------------------------------------

set RESTOPOS_KKT=bench
start "" "%~dp0apps\desktop\src-tauri\target\debug\desktop.exe"
