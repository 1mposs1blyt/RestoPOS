{
  "name": "@restopos/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST + WebSocket бэкенд RestoPOS (Fastify + PostgreSQL + socket.io)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "db:schema": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@restopos/shared-types": "workspace:*",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
