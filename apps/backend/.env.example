# Хост и порт HTTP/WS-сервера. Клиенты по умолчанию ждут бэкенд на :3000
# (см. VITE_API_URL в apps/*/src/api.ts).
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restopos

# CORS: список origin через запятую. Пусто — разрешить все (только для dev).
CORS_ORIGINS=http://localhost:1420,http://localhost:1430

# Dev-обход аутентификации: контекст арендатора берётся из заголовков
# x-org-id / x-venue-id / x-terminal-kind / x-staff-id / x-staff-role,
# пока нет входа по PIN и токенов смены. НИКОГДА не включать в проде.
AUTH_DEV_BYPASS=1
