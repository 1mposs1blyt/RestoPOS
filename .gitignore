# rust / tauri
target/
apps/*/src-tauri/target/
src-tauri/target/
apps/*/src-tauri/gen/schemas/

# tauri mobile generated projects
# (android/ и ios/ генерируются командой `tauri android init` / `tauri ios init`.
#  Их принято коммитить, если в них есть ручные правки — иконки, permissions,
#  signing config. Пока правок нет, держим их вне git и генерируем локально.)
apps/mobile/src-tauri/gen/android/
apps/mobile/src-tauri/gen/apple/

# android
*.keystore
*.jks
local.properties
.gradle/

