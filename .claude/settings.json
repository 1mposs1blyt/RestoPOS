{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "PowerShell(pnpm *)",
      "Bash(node scripts/*)",
      "PowerShell(node scripts/*)",
      "Bash(npx biome *)",
      "PowerShell(npx biome *)",
      "Bash(npx vitest *)",
      "PowerShell(npx vitest *)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "PowerShell(cargo test*)",
      "PowerShell(cargo build*)",
      "PowerShell(cargo check*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git checkout -b *)",
      "Read"
    ],
    "deny": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git checkout -- *)",
      "PowerShell(git checkout -- *)",
      "Bash(git clean*)",
      "PowerShell(git clean*)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item -Recurse*)",
      "Edit(apps/backend/**)",
      "Write(apps/backend/**)",
      "Edit(script.sql)",
      "Write(script.sql)",
      "Edit(packages/shared-types/src/contract.generated.ts)",
      "Write(packages/shared-types/src/contract.generated.ts)"
    ]
  }
}
