{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      // Форма `/**` обязательна: без неё исключение не срабатывает вовсе
      // и в проверку попадает node_modules целиком.
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/src-tauri/target/**",
      "!**/gen/**",
      // Статика: иконки Tauri и фон логотипа — чужие ассеты, не наш код.
      "!**/public/**",
      // Генерируется из contracts/contract.json — правится не здесь.
      "!packages/shared-types/src/contract.generated.ts",
      // Схема чужого продукта, 757 КБ UTF-16.
      "!script.sql"
    ]
  },
  // Форматтер выключен намеренно: в коде много ручной вёрстки комментариев
  // и выравнивания по смыслу, а сплошное переформатирование дало бы огромный
  // диф, в котором не видно содержательных правок.
  "formatter": { "enabled": false },
  // Ассисты (сортировка импортов) тоже: они трогают каждый файл, не находя
  // при этом ни одной ошибки.
  "assist": { "enabled": false },
  // Tailwind v4 использует собственные директивы (`@source`, `@import
  // "tailwindcss"`), и без этого флага парсер CSS на них падает.
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Правило требует папочный синтаксис `!dir/`, но с ним исключения
        // перестают работать — проверено: в обход попадал node_modules.
        "useBiomeIgnoreFolder": "off"
      },
      "a11y": {
        // Целевое железо — сенсорный моноблок в киоск-режиме. Клавиатуры
        // у кассира нет, и требовать onKeyDown рядом с onClick здесь незачем:
        // правило рассчитано на веб-страницы, а не на терминал.
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      }
    }
  }
}
