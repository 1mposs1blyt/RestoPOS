{
  "name": "restopos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "dev:desktop": "pnpm --filter @restopos/desktop tauri dev",
    "dev:mobile": "pnpm --filter @restopos/mobile tauri dev",
    "android:dev": "pnpm --filter @restopos/mobile tauri android dev",
    "android:init": "pnpm --filter @restopos/mobile tauri android init",
    "ios:dev": "pnpm --filter @restopos/mobile tauri ios dev",
    "ios:init": "pnpm --filter @restopos/mobile tauri ios init",
    "build:desktop": "pnpm --filter @restopos/desktop tauri build",
    "build:web": "pnpm -r --filter \"./apps/*\" build",
    "contracts:build": "node scripts/build-contract.mjs",
    "contracts:check": "node scripts/build-contract.mjs --check",
    "typecheck": "pnpm contracts:check && pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:front": "pnpm --filter @restopos/shared-types --filter @restopos/api-client --filter @restopos/ui-kit --filter @restopos/desktop --filter @restopos/mobile typecheck",
    "verify": "pnpm contracts:check && pnpm lint && pnpm typecheck:front && pnpm test && pnpm build:web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pnpm": "^11.22.0"
  }
}
